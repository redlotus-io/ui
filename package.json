{
  "name": "@redlotus/ui",
  "version": "0.1.60",
  "description": "React UI library",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint:fix": "eslint --fix --ext .js,.ts,.tsx ./src --ignore-path .gitignore",
    "clean": "rm -rf node_modules/ && rm -rf yarn.lock && yarn",
    "build": "vite build && yarn gen-types",
    "gen-types": "tsc --emitDeclarationOnly --declaration --declarationDir dist/types"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redlotus-io/ui"
  },
  "keywords": [
    "react",
    "tailwindcss"
  ],
  "files": [
    "dist",
    "public",
    "README.md"
  ],
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "@/types": "dist/types/src/index.d.ts",
  "author": "Tomi Markus Alber",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/redlotus-io/ui/issues"
  },
  "homepage": "https://github.com/redlotus-io/ui#readme",
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@headlessui/react": "^1.7.10",
    "@popperjs/core": "^2.11.6",
    "@radix-ui/react-popover": "^1.0.3",
    "@react-hook/window-size": "^3.1.1",
    "clsx": "^1.2.1",
    "date-fns": "^2.29.3",
    "formik": "^2.2.9",
    "framer-motion": "^9.0.2",
    "next": "^13.1.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hotkeys-hook": "^4.3.5",
    "react-icons": "4.7.1",
    "react-router-dom": "^6.8.1",
    "react-use-measure": "^2.1.1",
    "tailwindcss": "^3.2.6",
    "tailwindcss-border-gradient-radius": "^3.0.1",
    "vite-plugin-pwa": "^0.14.3",
    "yup": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.4.3",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^3.1.0",
    "autoprefixer": "^10.4.13",
    "babel-loader": "^8.3.0",
    "c8": "^7.12.0",
    "eslint-config-redlotus-react": "^0.1.6",
    "husky": "^8.0.3",
    "jsdom": "^21.1.0",
    "lint-staged": "^13.1.1",
    "postcss": "^8.4.21",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "tailwind-scrollbar": "^2.1.0",
    "tailwind-scrollbar-hide": "^1.1.7",
    "tailwindcss-animate": "^1.0.5",
    "typescript": "^4.9.5",
    "vite": "^4.1.1",
    "vite-plugin-checker": "^0.5.5",
    "vite-tsconfig-paths": "^4.0.5",
    "vitest": "^0.28.4"
  },
  "peerDependencies": {
    "@emotion/react": ">=11.10.5",
    "@emotion/styled": ">=11.10.5",
    "@headlessui/react": ">=1.7.3",
    "@react-hook/window-size": ">=3.1.1",
    "clsx": ">=1.2.1",
    "date-fns": ">=2.29.3",
    "formik": ">=2.2.9",
    "framer-motion": ">=7.6.4",
    "react": "^17 || ^18",
    "react-dom": "^17 || ^18",
    "react-icons": ">=4.3.1",
    "react-router-dom": ">=6.3.0",
    "tailwindcss-border-gradient-radius": ">=3.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
